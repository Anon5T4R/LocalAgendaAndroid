<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Base app theme — applied after the splash screen exits.
      Transparent bars so Compose edge-to-edge insets take full control.
    -->
    <style name="Theme.LocalAgenda.Base" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!--
      Splash screen theme (androidx.core:core-splashscreen).
      - Background: azul da marca (accent do LocalAgenda desktop, #2563eb)
      - Animated icon: calendário branco
      - After splash: switches to the base theme
    -->
    <style name="Theme.LocalAgenda.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#2563EB</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.LocalAgenda.Base</item>
    </style>
</resources>
